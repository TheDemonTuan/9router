{
  "name": "9router-app",
  "version": "0.5.95",
  "description": "9Router web dashboard",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare:chatgpt-session-export": "bun scripts/build-chatgpt-session-export.mjs",
    "dev": "bun run prepare:chatgpt-session-export && bun --bun next dev --port 20127",
    "dev:webpack": "bun run prepare:chatgpt-session-export && bun --bun next dev --webpack --port 20127",
    "build": "bun run prepare:chatgpt-session-export && bun --bun next build",
    "build:webpack": "bun run prepare:chatgpt-session-export && bun --bun next build --webpack",
    "postbuild": "bun scripts/copy-standalone-assets.mjs",
    "start": "bun custom-server.js --port 20127",
    "start:standalone": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "bun --prefix cli run pack:cli",
    "cli:publish": "bun --prefix cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.3.7",
    "@node-saml/node-saml": "^5.1.0",
    "@novnc/novnc": "1.7.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "8.20.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "confbox": "^0.3.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "material-symbols": "^0.47.5",
    "monaco-editor": "^0.57.0",
    "next": "16.3.7",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^16.13.1",
    "recharts": "^3.10.1",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^7.30.0",
    "ws": "8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "fflate": "0.8.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "source-map-js": "1.2.2"
  }
}
