{
  "manifest_version": 3,
  "name": "9Router ChatGPT Session Export",
  "version": "1.2.0",
  "key": "",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+9" } } },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; object-src 'none'; connect-src 'none'"
  }
}
