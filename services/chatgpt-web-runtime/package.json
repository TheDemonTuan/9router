{
  "name": "@9router/chatgpt-web-runtime",
  "version": "6.1.3",
  "private": true,
  "description": "Isolated ChatGPT Web browser and MCP runtime for 9Router",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miuuyy/codex-chatgpt-web.git"
  },
  "homepage": "https://github.com/miuuyy/codex-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/miuuyy/codex-chatgpt-web/issues"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "test": "bun test ./tests",
    "typecheck": "bun x --no-install --bun tsc --noEmit",
    "start": "bun src/server.ts",
    "companion": "bun src/companion/main.ts",
    "companion:keygen": "bun src/companion/keygen.ts",
    "companion:interrupt": "bun src/companion/interrupt.ts",
    "smoke:offline": "bun scripts/smoke-offline.ts",
    "smoke:live": "bun scripts/smoke-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright-core": "^1.62.0",
    "tiktoken": "1.0.22",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.5",
    "qs": "6.16.0",
    "zod-to-json-schema": "3.25.1"
  },
  "license": "MIT"
}
