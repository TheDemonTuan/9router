# syntax=docker/dockerfile:1.7
# Build Chromium stable from source on immutable Ubuntu 24.04 snapshot
FROM ubuntu:noble@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60 AS builder

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 1. Bootstrap CA certificates with exact snapshot package sha256
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 \
    https://snapshot.ubuntu.com/ubuntu/20261003T000000Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb \
    /build/ca-certificates.deb

# 2. Copy immutable signed snapshot installer and configure build packages
COPY services/chatgpt-web-runtime/scripts/install-ubuntu-snapshot.sh /build/install-ubuntu-snapshot.sh
RUN chmod +x /build/install-ubuntu-snapshot.sh && \
    /build/install-ubuntu-snapshot.sh --ca-bootstrap /build/ca-certificates.deb --arch "${TARGETARCH}" \
    git python3 python3-pip curl file lsb-release xz-utils zstd pkg-config \
    bison flex gperf build-essential ninja-build cmake ca-certificates libasound2t64 \
    libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
    libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0t64 libgtk-3-0t64 libnspr4 \
    libnss3 libpango-1.0-0 libudev1 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
    libxext6 libxfixes3 libxkbcommon0 libxrandr2 clang-18 llvm-18 lld-18 \
    sudo libssl-dev libncurses-dev zlib1g-dev liblzma-dev libzstd-dev \
    libfontconfig1 libgcc-s1 libstdc++6

# 3. Copy source lock and build script
WORKDIR /workspace
COPY chromium-source-lock.json /workspace/
COPY scripts/build-chromium-source.py scripts/bootstrap-chromium-arm64.py /workspace/scripts/

# 4. Execute complete source build and package staging
RUN python3 /workspace/scripts/build-chromium-source.py \
    --arch "${TARGETARCH}" \
    --workdir /build/chromium-build \
    --dest /opt/chromium

# Separate source path is an immutable corresponding-source distributable.
# Runtime consumers COPY only /opt/chromium, not this source archive.
FROM scratch
COPY --from=builder /opt/chromium /opt/chromium
COPY --from=builder /usr/local/share/chromium-source /usr/local/share/chromium-source
