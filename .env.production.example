# ------------------------------------------------------------------------------
# 9router Production Environment Configuration (Split-Domain + Cloudflare Access)
# ------------------------------------------------------------------------------

# Admin Dashboard (Protected by Cloudflare Access)
DASHBOARD_HOST=9router-admin.tuannguyenviet.site
PUBLIC_URL=https://9router-admin.tuannguyenviet.site

# Public Hardened Model-Serving API (Bypasses Cloudflare Access, requires valid API key)
API_HOST=9router-api.tuannguyenviet.site

# Cloudflare Access Zero Trust verification (Optional, automatic JWT verification)
CLOUDFLARE_ACCESS_TEAM_NAME=thedemontuan
CLOUDFLARE_ACCESS_AUD=

# Traefik Integration
EDGE_NETWORK=edge-9router
TRAEFIK_DYNAMIC_DIR=/opt/platform/edge/dynamic
TRAEFIK_CONFIG_NAME=9router.yml

# Deployment Healthcheck Timeout (seconds)
READY_TIMEOUT=60

# Runtime settings
NODE_ENV=production
PORT=20128
INITIAL_PASSWORD=123456
DATA_DIR=/app/data
